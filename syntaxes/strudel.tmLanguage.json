{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Strudel",
  "scopeName": "source.strudel",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#lane-label"
    },
    {
      "include": "#strings"
    },
    {
      "include": "source.js"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.strudel",
          "match": "//.*$"
        },
        {
          "name": "comment.block.strudel",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "lane-label": {
      "patterns": [
        {
          "match": "^\\s*(_?\\$[a-zA-Z0-9_]*)(:)",
          "captures": {
            "1": {
              "name": "entity.name.tag.lane.strudel"
            },
            "2": {
              "name": "punctuation.separator.lane.strudel"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.strudel",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.strudel",
              "match": "\\\\."
            },
            {
              "include": "#mini-notation"
            }
          ]
        },
        {
          "name": "string.quoted.single.strudel",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.strudel",
              "match": "\\\\."
            },
            {
              "include": "#mini-notation"
            }
          ]
        },
        {
          "name": "string.template.strudel",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.strudel",
              "match": "\\\\."
            },
            {
              "include": "#mini-notation"
            }
          ]
        }
      ]
    },
    "mini-notation": {
      "patterns": [
        {
          "name": "keyword.operator.mini.strudel",
          "match": "[<>\\[\\]{},*!/@?:~]"
        },
        {
          "name": "constant.other.note.mini.strudel",
          "match": "(?<![a-zA-Z0-9_])[a-gA-G][#b]?[0-9](?![a-zA-Z0-9_])"
        },
        {
          "name": "constant.numeric.mini.strudel",
          "match": "(?<![a-zA-Z0-9_])\\d+(?:\\.\\d+)?(?![a-zA-Z0-9_])"
        }
      ]
    }
  }
}
