{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Strudel",
  "scopeName": "source.strudel",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#lane-label"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#method-call"
    },
    {
      "include": "#function-call"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.strudel",
          "match": "//.*$"
        },
        {
          "name": "comment.block.strudel",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "lane-label": {
      "patterns": [
        {
          "name": "entity.name.tag.lane.strudel",
          "match": "^\\s*(?:_?\\$[a-zA-Z0-9_]*|\\b[a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*:)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.strudel",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.strudel",
              "match": "\\\\."
            },
            {
              "include": "#mini-notation"
            }
          ]
        },
        {
          "name": "string.quoted.single.strudel",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.strudel",
              "match": "\\\\."
            },
            {
              "include": "#mini-notation"
            }
          ]
        },
        {
          "name": "string.template.strudel",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.strudel",
              "match": "\\\\."
            },
            {
              "include": "#mini-notation"
            }
          ]
        }
      ]
    },
    "mini-notation": {
      "patterns": [
        {
          "name": "keyword.operator.mini.strudel",
          "match": "[<>\\[\\]{},*!/@?:~]"
        },
        {
          "name": "constant.numeric.mini.strudel",
          "match": "\\b[a-gA-G][#b]?[0-9]\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.strudel",
          "match": "\\b(?:const|let|var|function|return|if|else|for|while|await|async|import|export|true|false|null|undefined)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.strudel",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "method-call": {
      "patterns": [
        {
          "match": "\\.([a-zA-Z_$][a-zA-Z0-9_$]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.method.strudel"
            }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.strudel"
            }
          }
        }
      ]
    }
  }
}
